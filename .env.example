DATABASE_URL="file:./dev.db"

# Auth.js v5. AUTH_URL is the canonical origin; AUTH_SECRET signs the session JWT.
AUTH_SECRET="dev-secret-change-me"
AUTH_URL="http://localhost:3000"

# Analytics adapter: "noop" (default) or "console".
ANALYTICS_DRIVER="console"
ANALYTICS_SALT="dev-salt"

# Optional enterprise sign-in. Set all three and a "Continue with …" button
# appears on /signin; leave any of them unset and there is no SSO door at all.
# SSO authenticates only: joining a workspace is still an invitation, and roles
# are still granted by an admin.
# AMX_OIDC_ISSUER="https://idp.example.com"
# AMX_OIDC_CLIENT_ID=""
# AMX_OIDC_CLIENT_SECRET=""
# AMX_OIDC_LABEL="Acme SSO"
